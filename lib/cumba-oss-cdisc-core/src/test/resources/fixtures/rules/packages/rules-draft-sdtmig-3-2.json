      },
      "Description": "Raise an error when --SOC is not empty but --SOCCD is missing or not present in dataset.",
      "Executability": "Fully Executable",
      "Scope": {
        "Classes": {
          "Include": [
            "EVENTS"
          ]
        },
        "Use_Case": "INDH"
      },
      "Requirements": {
        "Variables": {
          "All": [
            "--SOC"
          ]
        }
      },
      "Check": {
        "expression": "not empty(--SOC) and empty(--SOCCD)"
      },
      "Outcome": {
        "Message": "--SOC is not empty but --SOCCD is missing or not present in dataset.",
        "Output_Variables": [
          "--SOC",
          "--SOCCD"
