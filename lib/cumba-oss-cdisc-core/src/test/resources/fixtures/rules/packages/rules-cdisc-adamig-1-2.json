      "Core": {
        "Id": "CDISC-AD0131",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when, within a given value of PARAMCD, BASETYPE is populated for at least one record and is not populated for at least one record.",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE"
          ]
        }
      },
      "Requirements": {
        "Variables": {
          "All": [
            "BASETYPE"
          ]
        }
      },
      "Grouping": {
        "Variables": [
          "PARAMCD"
        ]
      },
      "Operations": [
        {
          "id": "$basetype_mixed",
          "expression": "has_mixed_emptiness_within_group(BASETYPE, group=[PARAMCD])"
        }
      ],
      "Check": {
        "expression": "$basetype_mixed == true"
      },
      "Outcome": {
        "Message": "BASETYPE is populated for some records and not populated for others within this PARAMCD.",
        "Output_Variables": [
          "PARAMCD",
          "BASETYPE"
        ]
      }
    },
