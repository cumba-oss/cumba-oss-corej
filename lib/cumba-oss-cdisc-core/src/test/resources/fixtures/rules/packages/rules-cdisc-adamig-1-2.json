      "Core": {
        "Id": "CDISC-AD0353",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when BASETYPE is present, ByIND is populated, and ByIND does not equal the AyIND value where ABLFL equals Y, for the same subject, parameter, and BASETYPE",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE"
          ]
        }
      },
      "Operations": [
        {
          "id": "$baseline_ayind",
          "expression": "max(\"AyIND\", group=[USUBJID, PARAMCD, BASETYPE], filter=filter(ABLFL=\"Y\"))"
        }
      ],
      "Check": {
        "expression": "var_exists(\"BASETYPE\") and not empty(ByIND) and ByIND != $baseline_ayind"
      },
      "Outcome": {
        "Message": "BASETYPE is present and ByIND is populated, but ByIND does not equal the AyIND value where ABLFL equals Y, for this subject, parameter, and BASETYPE.",
        "Output_Variables": [
          "PARAMCD",
          "BASETYPE",
          "ByIND",
          "$baseline_ayind"
        ]
      },
      "wildcards": {
        "y": {
          "min": 1,
          "max": 99
        }
      }
    },
