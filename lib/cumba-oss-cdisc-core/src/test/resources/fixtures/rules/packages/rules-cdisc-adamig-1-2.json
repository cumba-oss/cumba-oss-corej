        "Id": "CDISC-AD0614",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when, on a BDS or OCCDS record where APHASEN is not present, PHEDTM does not equal any ADSL variable PHwEDTM (for any w) for the same USUBJID.",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE",
            "OCCURRENCE DATA STRUCTURE"
          ]
        }
      },
      "Match_Datasets": [
        {
          "Name": "ADSL",
          "Keys": [
            "USUBJID"
          ]
        }
      ],
      "Check": {
        "expression": "not var_exists(\"APHASEN\") and not empty(PHEDTM) and PHEDTM not in ADSL.PH${*}EDTM"
      },
      "Outcome": {
        "Message": "On a given record, APHASEN is not present and the value of PHEDTM does not equal any PHwEDTM variable",
        "Output_Variables": [
          "PHEDTM"
        ]
      }
    },
    "CDISC-AD0615": {
      "Authorities": [
        {
          "Organization": "CDISC",
          "Standards": [
