            }
          ]
        }
      ],
      "Core": {
        "Id": "CDISC-AD0615",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when, on a BDS or OCCDS record where APHASEN is populated, PHEDTM does not equal the ADSL variable PHwEDTM for the same USUBJID (where w equals the record's APHASEN value).",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE",
            "OCCURRENCE DATA STRUCTURE"
          ]
        }
      },
      "Match_Datasets": [
        {
          "Name": "ADSL",
          "Keys": [
            "USUBJID"
          ]
        }
      ],
      "Check": {
        "expression": "not empty(APHASEN) and not empty(PHEDTM) and PHEDTM != ADSL.PH${APHASEN:%d}EDTM"
      },
      "Outcome": {
        "Message": "On a given record, APHASEN is populated and the value of PHEDTM is not equal to the value of variable PHwEDTM where w equals the value of APHASEN",
        "Output_Variables": [
          "APHASEN",
          "PHEDTM",
          "ADSL.PH${*}EDTM"
        ]
      }
    }
  }
