      "Core": {
        "Id": "CDISC-AD0581",
        "Status": "Published",
        "Version": "2"
      },
      "Description": "Raise an error when none of TRTP, TRTPGy, TRTA, TRTAGy, ARM, ACTARM, TRTxxP, TRTxxA, TRTSEQP, TRTSEQA, TRxxPGy, TRxxAGy, TSEQPGy, or TSEQAGy are present, where xx is an integer [01-99, zero-padded] and y is an integer [1-99, not zero-padded].",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE",
            "MEDICAL DEVICE BASIC DATA STRUCTURE"
          ]
        }
      },
      "Check": {
        "expression": "not var_exists(\"TRTP\") and not var_exists(\"TRTPGy\") and not var_exists(\"TRTA\") and not var_exists(\"TRTAGy\") and not var_exists(\"ARM\") and not var_exists(\"ACTARM\") and not var_exists(\"TRTxxP\") and not var_exists(\"TRTxxA\") and not var_exists(\"TRTSEQP\") and not var_exists(\"TRTSEQA\") and not var_exists(\"TRxxPGy\") and not var_exists(\"TRxxAGy\") and not var_exists(\"TSEQPGy\") and not var_exists(\"TSEQAGy\")"
      },
      "Outcome": {
        "Message": "None of TRTP, TRTPGy, TRTA, TRTAGy, ARM, ACTARM, TRTxxP, TRTxxA, TRTSEQP, TRTSEQA, TRxxPGy, TRxxAGy, TSEQPGy, or TSEQAGy are present, where xx is an integer [01-99, zero-padded] and y is an integer [1-99, not zero-padded]",
        "Output_Variables": []
      },
      "wildcards": {
        "xx": {
          "min": 1,
          "max": 99
        },
        "y": {
          "min": 1,
          "max": 99
        }
      }
    },
