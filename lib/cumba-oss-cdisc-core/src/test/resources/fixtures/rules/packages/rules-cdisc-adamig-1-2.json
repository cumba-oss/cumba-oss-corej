      "Description": "Raise an error when, on a BDS or OCCDS record, APEREDTM does not equal the ADSL variable APxxEDTM for the same USUBJID (where xx equals the record's APERIOD value).",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "BASIC DATA STRUCTURE",
            "OCCURRENCE DATA STRUCTURE"
          ]
        }
      },
      "Match_Datasets": [
        {
          "Name": "ADSL",
          "Keys": [
            "USUBJID"
          ]
        }
      ],
      "Check": {
        "expression": "not empty(APEREDTM) and not empty(ADSL.AP${APERIOD:%02d}EDTM) and APEREDTM != ADSL.AP${APERIOD:%02d}EDTM"
      },
      "Outcome": {
        "Message": "On a given record, the value of APEREDTM is not equal to the value of variable APxxEDTM where xx equals the value of APERIOD",
        "Output_Variables": [
          "APERIOD",
          "APEREDTM",
          "ADSL.AP${*}EDTM"
        ]
      }
    },
