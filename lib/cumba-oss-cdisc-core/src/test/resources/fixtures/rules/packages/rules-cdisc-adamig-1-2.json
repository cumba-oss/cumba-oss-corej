      "Core": {
        "Id": "CDISC-AD0084",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when TRTEDT and the maximum value across all TRxxEDT variables are both populated and TRTEDT does not equal that maximum, where xx is an integer [01-99, zero-padded]",
      "Executability": "Fully Executable",
      "Scope": {
        "Data_Structures": {
          "Include": [
            "SUBJECT LEVEL ANALYSIS DATASET"
          ]
        }
      },
      "Operations": [
        {
          "id": "$trxx_max",
          "expression": "row_max(name_pattern=\"^TR(0[1-9]|[1-9][0-9])EDT$\")"
        }
      ],
      "Check": {
        "expression": "not empty(TRTEDT) and not empty($trxx_max) and TRTEDT != $trxx_max"
      },
      "Outcome": {
        "Message": "TRTEDT does not equal the maximum value among the TRxxEDT variables",
        "Output_Variables": [
          "TRTEDT",
          "$trxx_max"
        ]
      }
    },
