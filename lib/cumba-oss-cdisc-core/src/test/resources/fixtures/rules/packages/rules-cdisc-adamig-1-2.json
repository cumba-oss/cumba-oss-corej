      "Core": {
        "Id": "CDISC-AD0053",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when a record's USUBJID does not have a matching record in SDTM.DM",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Match_Datasets": [
        {
          "Name": "DM",
          "Keys": [
            "USUBJID"
          ],
          "Join_Type": "left"
        }
      ],
      "Check": {
        "expression": "var_exists(DM.USUBJID) and empty(DM.USUBJID)"
      },
      "Outcome": {
        "Message": "This record's USUBJID value was not found in SDTM.DM",
        "Output_Variables": [
          "DM.USUBJID"
        ]
      }
    },
