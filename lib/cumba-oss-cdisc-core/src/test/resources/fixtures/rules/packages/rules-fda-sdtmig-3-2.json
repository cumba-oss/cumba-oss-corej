      "Core": {
        "Id": "FDA-CT2001",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when a non-empty value is not a term in the non-extensible CDISC controlled terminology codelist the CDISC Library defines for the variable. A variable must be populated with terms from its CDISC controlled-terminology codelist; new terms cannot be added to a non-extensible codelist.",
      "Executability": "Partially Executable - Possible Underreporting",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Library": true
      },
      "Check": {
        "expression": "var_codelist_extensible(\"LIBRARY\") == false and not empty(var_codelist_coded_values(\"LIBRARY\")) and not empty(value()) and value() not in var_codelist_coded_values(\"LIBRARY\")"
      },
      "Outcome": {
        "Message": "The value is not a term in the non-extensible CDISC controlled terminology codelist the CDISC Library defines for this variable.",
        "Output_Variables": [
          "variable_name",
          "variable_value"
        ]
      },
      "Source": {
        "FDA_Validator_Rule_Message": "Variable value not found in non-extensible codelist",
        "FDA_Validator_Rule_Description": "Variable must be populated with terms from its CDISC controlled terminology codelist. New terms cannot be added into non-extensible codelists.",
        "Domains": "ALL"
      }
    },
