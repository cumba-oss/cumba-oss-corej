      "Core": {
        "Id": "CDISC-CG0008",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when the planned elapsed time (--ELTM) is populated but its fixed reference point (--TPTREF) is empty; --ELTM must be empty when --TPTREF is empty.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Variables": {
          "All": [
            "--ELTM"
          ]
        }
      },
      "Check": {
        "expression": "empty(--TPTREF) and not empty(--ELTM)"
      },
      "Outcome": {
        "Message": "--ELTM is populated but --TPTREF is empty.",
        "Output_Variables": [
          "--ELTM",
          "--TPTREF"
        ]
      }
    },
