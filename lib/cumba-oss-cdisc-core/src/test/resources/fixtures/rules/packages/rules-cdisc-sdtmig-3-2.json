      "Core": {
        "Id": "CDISC-CG0006",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when the collection Study Day (--DY) is populated and both the date portion of --DTC and the date portion of RFSTDTC are complete dates, but --DY does not equal the value computed by the SDTM study day algorithm (a non-zero integer).",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Variables": {
          "All": [
            "--DTC",
            "--DY"
          ]
        }
      },
      "Match_Datasets": [
        {
          "Keys": [
            "USUBJID"
          ],
          "Name": "DM"
        }
      ],
      "Operations": [
        {
          "id": "$value_dy_algorithm",
          "expression": "dy(--DTC)"
        }
      ],
      "Check": {
        "expression": "not empty(--DY) and is_complete_date_part(--DTC) and is_complete_date_part(DM.RFSTDTC) and --DY != $value_dy_algorithm"
      },
      "Outcome": {
        "Message": "--DY does not equal the value derived by the SDTM study day algorithm even though the date portions of --DTC and RFSTDTC are complete dates and --DY is populated.",
        "Output_Variables": [
          "$value_dy_algorithm",
          "--DTC",
          "--DY",
          "DM.RFSTDTC"
        ]
      }
    },
    "CDISC-CG0007": {
