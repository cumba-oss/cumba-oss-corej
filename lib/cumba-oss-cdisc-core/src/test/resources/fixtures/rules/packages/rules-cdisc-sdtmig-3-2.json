      "Core": {
        "Id": "CDISC-CG0009",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when EPOCH is populated but does not match any EPOCH value in the TA dataset.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Variables": {
          "All": [
            "EPOCH"
          ]
        }
      },
      "Operations": [
        {
          "id": "$ta_epoch",
          "expression": "distinct(EPOCH, domain=\"TA\")"
        }
      ],
      "Check": {
        "expression": "EPOCH not in $ta_epoch and not empty(EPOCH)"
      },
      "Outcome": {
        "Message": "EPOCH value does not match any EPOCH value in the TA dataset.",
        "Output_Variables": [
          "EPOCH",
          "$ta_epoch"
        ]
      }
    }
