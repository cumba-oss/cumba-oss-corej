<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- ================================================================ -->
    <!-- 1. Generic project-wide FP categories                            -->
    <!--    Every instance of these patterns is structurally an FP in     -->
    <!--    this codebase by project convention. Only categories with     -->
    <!--    at least one finding in this module are listed.               -->
    <!-- ================================================================ -->

    <Match>
        <!-- THROWS_METHOD_THROWS_RUNTIMEEXCEPTION: Established project
             pattern (LazyValue.get, parser-style rethrows in
             DataSetJsonTableParallelParser/URIBuilder); declaring the
             unchecked throws makes the contract visible to callers. -->
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    </Match>

    <!-- ================================================================ -->
    <!-- 2. Targeted suppressions                                         -->
    <!--    One <Match> per unique (class, method-or-field, bug pattern)  -->
    <!--    tuple. Multiple findings sharing the same tuple collapse into -->
    <!--    one Match (filter has no line-level scope).                   -->
    <!-- ================================================================ -->

    <Match>
        <!-- Test-fixture provider exposes its in-memory metadata map by
             reference so test setup can mutate it across scenario tweaks
             without rebuilding the provider. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getDatasetMetadataMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Test-fixture provider exposes its in-memory metadata map by
             reference so test setup can mutate it across scenario tweaks
             without rebuilding the provider. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getDomainVariablesMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Test-fixture provider exposes its in-memory metadata map by
             reference so test setup can mutate it across scenario tweaks
             without rebuilding the provider. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getModelVariablesMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Test-fixture provider exposes its in-memory metadata map by
             reference so test setup can mutate it across scenario tweaks
             without rebuilding the provider. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getCodelistTermMappingsMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Test-fixture provider exposes its in-memory metadata map by
             reference so test setup can mutate it across scenario tweaks
             without rebuilding the provider. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getVariableMetadataMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Same tuple as the getters above, for the CT2003 codelist code map
             (Fix #324): the introspection getter serves the scenario writer and
             returns the already-unmodifiable deep copy the constructor built. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getCodelistCodesMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Same shape as getModelVariablesMap / getCodelistCodesMap (EC-85,
             #library model-class-variables): the introspection getter serves
             the scenario writer and returns the unmodifiable deep copy the
             constructor built. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.MapBackedLibraryMetadataProvider" />
        <Method name="getModelClassVariablesMap" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <Match>
        <!-- Path.getFileName() chains in scenario capture / trimmer:
             only null for root paths, unreachable for scenario file
             paths. -->
        <Class name="net.cumba.dataviewer.examples.cdt.ruletest.ScenarioCapture" />
        <Method name="writeScenario" />
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>

</FindBugsFilter>
