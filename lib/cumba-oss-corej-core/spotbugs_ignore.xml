    -->
    <Match>
        <!--
            Verified false positive (SpotBugs 4.10). LibraryValidator's resolver returns
            lookup.keySet() from availableDatasets(), and `lookup` is built as
            Map.copyOf(mutable) precisely so it can be published to rule threads unsynchronised
            (the comment at the freeze says so). An immutable map's keySet is an immutable view,
            so nothing mutable is exposed; SpotBugs simply does not track immutability through
            Map.copyOf.
        -->
        <Class name="~net\.cumba\.corej\.core\.report\.LibraryValidator\$\d+" />
        <Method name="availableDatasets" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

</FindBugsFilter>
