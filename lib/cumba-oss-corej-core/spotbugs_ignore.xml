    <!-- Rule.effectiveOutputVariablesOrAuthored (EC-37): the effective list is installed by
         RulePackageLoader.deriveOutputVariables as List.copyOf(...) — already immutable — and
         the authored fallback exposes Outcome's own list exactly as the Lombok getter the
         execution path read before EC-37. A defensive copy on this per-rule-execution hot
         path would be pure allocation churn. -->
    <Match>
        <Class name="net.cumba.corej.core.model.Rule" />
        <Method name="effectiveOutputVariablesOrAuthored" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <!-- Fix #354: the sibling exclusion set. Same contract — installed once by
         RulePackageLoader.deriveOutputVariables as OutputVariableDeriver.excludedOf's
         unmodifiable set, read by RuleRunner's fallbacks on every execution. -->
    <Match>
        <Class name="net.cumba.corej.core.model.Rule" />
        <Method name="excludedOutputVariablesOrAuthored" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Rule.effectiveGroupingVariables (Grouping: block): the exact shape of the EC-37
         sibling suppressed immediately above — a resolver that returns either the block's
         list or the flat Grouping_Variables field, on the per-rule-execution path
         (RuleRunner, RuleCohortGrouper, RuleClassifier). All 15 call sites read only:
         they iterate it, addAll it, or pass it through Objects.requireNonNull; none
         mutates. A defensive copy would be pure allocation churn on a hot path.
         NOTE: unlike the EC-37 list, this one is NOT List.copyOf — it is Jackson's own
         list — so the contract here is read-only-by-convention, not immutability. -->
    <Match>
        <Class name="net.cumba.corej.core.model.Rule" />
        <Method name="effectiveGroupingVariables" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Plan C phase 4 — Rule.effectiveCheckLevels: the same hot-path accessor shape as the
         EC-37 entries above, and here the collection is genuinely immutable, not merely
         read-only by convention. setCheckLevels stores
         Collections.unmodifiableSequencedMap(new LinkedHashMap<>(levels)) — a defensive copy on
         the cold load/clone path — so the map this returns cannot be mutated through the
         reference. SpotBugs cannot see through unmodifiableSequencedMap (it DOES see through
         List.copyOf, which is why the sibling CheckLevelPlan.outputVariables finding
         disappeared once that record copied). A defensive copy here would be pure allocation
         churn on the per-rule-execution path. -->
    <Match>
        <Class name="net.cumba.corej.core.model.Rule" />
        <Method name="effectiveCheckLevels" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Plan C phase 4 — RuleCheck.levels: identical contract one layer down. The record's
         compact constructor wraps the deserialiser's mutable map in
         Collections.unmodifiableSequencedMap(new LinkedHashMap<>(...)), so the accessor returns
         an immutable view; only SpotBugs' inability to recognise that wrapper keeps the
         finding alive. Mirrors the VlmResolver$VlmMatch entry above. -->
    <Match>
        <Class name="net.cumba.corej.core.model.RuleCheck" />
        <Method name="levels" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>

    <!-- Documented tri-state Boolean, same convention as the four entries above:
         null = "the rule is silent on keep_missings" and is a DIFFERENT state from both
         TRUE and FALSE — silence resolves to the engine default, whereas an authored
         false is an explicit author decision that the grouping policy records. Collapsing
         null into false would erase exactly the distinction the Grouping: block exists to
         express. Pinned by KeepMissingsDeclarationTest (assertNull on both silent shapes). -->
    <Match>
        <Class name="net.cumba.corej.core.model.Rule" />
        <Method name="groupingKeepMissings" />
        <Bug pattern="NP_BOOLEAN_RETURN_NULL" />
    </Match>

    <!--
        ⛔⛔ REGEX MATCHER — the dots below are ESCAPED, so this line contains no
        contiguous "net.cumba.corej.core" and a package rename done by literal
        search-and-replace WILL SILENTLY MISS IT. The suppression then stops matching and
