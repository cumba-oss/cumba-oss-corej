<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- ================================================================ -->
    <!-- 1. Generic project-wide FP categories                            -->
    <!--    Every instance of these patterns is structurally an FP in     -->
    <!--    this codebase by project convention. Only categories with     -->
    <!--    at least one finding in this module are listed.               -->
    <!-- ================================================================ -->

    <Match>
        <!-- PZLA_PREFER_ZERO_LENGTH_ARRAYS: codebase chose null sentinels
             for "not found" vs empty result (style preference); changing
             to zero-length arrays would destroy the documented signal. -->
        <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS" />
    </Match>

    <Match>
        <!-- REC_CATCH_EXCEPTION: library-boundary normalisation is
             intentional; catch (Exception) wraps unknown JDK / library
             failures into project-typed exceptions or fallback values. -->
        <Bug pattern="REC_CATCH_EXCEPTION" />
    </Match>

    <Match>
        <!-- THROWS_METHOD_THROWS_RUNTIMEEXCEPTION: established project
             pattern (LazyValue.get, parser-style rethrows); declaring
             the unchecked throws makes the contract visible to callers. -->
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    </Match>

    <Match>
        <!-- UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR: Jackson
             @Data @NoArgsConstructor DTOs and Lombok builder beans
             populate fields post-construction rather than in the
             constructor; project-wide convention. -->
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" />
    </Match>

    <!-- ================================================================ -->
    <!-- 2. Targeted suppressions                                         -->
    <!--    One <Match> per unique (class, method-or-field, bug pattern)  -->
    <!--    tuple. Multiple findings sharing the same tuple collapse into -->
    <!--    one Match (filter has no line-level scope).                   -->
    <!-- ================================================================ -->

    <!-- J5 IDVARVAL coercion: an exact integral test (d == Math.floor(d))
         is intentional and correct here — it canonicalises a numeric join
         token to its long form only when the double is EXACTLY integral
         (mirrors DataValueDouble.getValueAsString trimming "1.0"->"1"). An
         epsilon compare would mis-canonicalise near-integral values; the
         range guard (< 2^53) keeps the floor exact. -->
    <Match>
        <Class name="net.cumba.corej.core.exec.ChildMatchIndex" />
        <Method name="normalizeJoinToken" />
        <Bug pattern="FE_FLOATING_POINT_EQUALITY" />
    </Match>

    <!-- CDISC rule engine: case folding is applied to standard names
         ("sdtmig","adamig"), domain codes (SDTM 2-letter), variable names
         (SAS-style, <=32 ASCII chars), CT package types, JSON CheckOperator
         tokens, and Pascal_Case rule-model keys. All are ASCII per
         CDISC SDTMIG / ADaMIG / CT spec; locale-insensitive folding is
         intentional. -->
    <Match>
        <Class name="net.cumba.corej.core.exec.CheckConditionOptimizer" />
        <Method name="evaluateLeafAgainstMetadata" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.exec.OperationExecutor" />
        <Method name="applicableCtPackageTypes" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.gen.RuleGenerator" />
        <Method name="isAdamStandard" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.gen.RuleGenerator" />
        <Method name="mapComparator" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.gen.RuleGenerator" />
        <Method name="mapSimpleDatatype" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.gen.RuleGenerator" />
        <Method name="parseStructureKeys" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.report.ReportAssembler" />
        <Method name="buildConformanceDetails" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.report.ReportAssembler" />
        <Method name="buildIssueDetails" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>
    <Match>
        <Class name="net.cumba.corej.core.report.ValidationReportBuilder" />
        <Method name="accumulatorFor" />
        <Bug pattern="DM_CONVERT_CASE" />
    </Match>

