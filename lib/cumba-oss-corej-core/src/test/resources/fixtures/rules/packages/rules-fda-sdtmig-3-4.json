{
  "standards": [
    {
      "id": "sdtmig/3-4",
      "role": "primary"
    }
  ],
  "rules": {
    "FDA-SD0054": {
      "Authorities": [
        {
          "Organization": "FDA",
          "Rule_Ids": [
            "SD0054"
          ]
        }
      ],
      "Core": {
        "Id": "FDA-SD0054",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when a variable declared in the Define-XML is not present in the submitted dataset.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Define": true
      },
      "Operations": [
        {
          "id": "$dataset_variables",
          "expression": "get_column_order_from_dataset()"
        },
        {
          "id": "$define_variables",
          "expression": "define_variable_names()"
        },
        {
          "id": "$missing_define_variables",
          "expression": "minus($define_variables, subtract=$dataset_variables)"
        }
      ],
      "Check": {
        "expression": "not contains_all($dataset_variables, $define_variables)"
      },
      "Outcome": {
        "Message": "A variable declared in the Define-XML is not present in the dataset.",
        "Output_Variables": [
          "$missing_define_variables"
        ]
      }
    },
    "FDA-SD0059": {
      "Authorities": [
        {
          "Organization": "FDA",
          "Rule_Ids": [
            "SD0059"
          ]
        }
      ],
      "Core": {
        "Id": "FDA-SD0059",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when the variable data type in the submitted dataset does not match the variable data type declared in the Define-XML.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Define": true
      },
      "Check": {
        "expression": "not empty(var_name(\"DEFINE\")) and var_type(\"DATA\") != var_type(\"DEFINE\")"
      },
      "Outcome": {
        "Message": "The variable data type in the dataset does not match the variable data type in the Define-XML.",
        "Output_Variables": [
          "variable_name",
          "variable_data_type",
          "define_variable_data_type"
        ]
      }
    },
    "FDA-SD0060": {
      "Authorities": [
        {
          "Organization": "FDA",
          "Rule_Ids": [
            "SD0060"
          ]
        }
      ],
      "Core": {
        "Id": "FDA-SD0060",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when a variable present in the submitted dataset is not declared in the Define-XML.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Define": true
      },
      "Check": {
        "expression": "not empty(varname()) and empty(var_name(\"DEFINE\"))"
      },
      "Outcome": {
        "Message": "The variable is present in the dataset but is not described in the Define-XML.",
        "Output_Variables": [
          "variable_name"
        ]
      }
    },
    "FDA-SD1324": {
      "Authorities": [
        {
          "Organization": "FDA",
          "Rule_Ids": [
            "SD1324"
          ]
        }
      ],
      "Core": {
        "Id": "FDA-SD1324",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when the variable label in the submitted dataset does not match the variable label declared in the Define-XML.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Define": true
      },
      "Check": {
        "expression": "not empty(var_name(\"DEFINE\")) and var_label(\"DATA\") != var_label(\"DEFINE\")"
      },
      "Outcome": {
        "Message": "The variable label in the dataset does not match the variable label in the Define-XML.",
        "Output_Variables": [
          "variable_name",
          "variable_label",
          "define_variable_label"
        ]
      }
    }
  }
}
