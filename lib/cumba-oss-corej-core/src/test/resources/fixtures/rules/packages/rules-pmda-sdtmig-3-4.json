{
  "standards": [
    {
      "id": "sdtmig/3-4",
      "role": "primary"
    }
  ],
  "rules": {
    "PMDA-SD1152": {
      "Authorities": [
        {
          "Organization": "PMDA",
          "Rule_Ids": [
            "SD1152"
          ]
        }
      ],
      "Core": {
        "Id": "PMDA-SD1152",
        "Status": "Published",
        "Version": "1"
      },
      "Description": "Raise an error when records are not unique for the combination of Key Variables declared in the Define-XML.",
      "Executability": "Fully Executable",
      "Scope": {
        "Domains": {
          "Include": [
            "ALL"
          ]
        }
      },
      "Requirements": {
        "Define": true
      },
      "Operations": [
        {
          "id": "$define_key_variables",
          "expression": "define_key_variables()"
        }
      ],
      "Check": {
        "expression": "not is_unique_set([STUDYID, $define_key_variables])"
      },
      "Outcome": {
        "Message": "Records are not unique for the combination of Key Variables declared in the Define-XML.",
        "Output_Variables": [
          "STUDYID",
          "$define_key_variables"
        ]
      }
    }
  }
}
