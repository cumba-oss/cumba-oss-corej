<?xml version="1.0" encoding="UTF-8"?>
<!-- NamelessDefineEntriesTest (register NNL §1): a Define-XML whose MetaDataVersion carries
     an ItemGroupDef WITHOUT a Name and one with a BLANK Name (between AE and DM, so a skipped
     entry is visible in the order too) and a CodeList with a CodeListItem WITHOUT a CodedValue and
     one with a BLANK CodedValue (flagged def:ExtendedValue="Yes", so the extended-values read
     sees it too), and DM ItemRefs to an ItemDef WITHOUT a Name and one with a BLANK Name, both
     carrying a KeySequence (review round 2, MEDIUM-1). All six are entries with no member (a blank
     string names nothing); the provider skips them, and never serves them as null or as "". -->
<ODM xmlns:def="http://www.cdisc.org/ns/def/v2.1" ODMVersion="1.3.2" FileType="Snapshot"
     FileOID="DEF.NAMELESS" CreationDateTime="2026-01-01T00:00:00">
  <Study OID="S1">
    <MetaDataVersion OID="MDV.1" Name="Nameless entries" DefineVersion="2.1.0"
                     StandardName="SDTM-IG" StandardVersion="3.4">
      <ItemGroupDef OID="IG.AE" Name="AE" Domain="AE" Repeating="Yes" Purpose="Tabulation"
                    SASDatasetName="AE">
        <ItemRef ItemOID="IT.AE.AETERM" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.NAMELESS" Repeating="Yes" Purpose="Tabulation">
        <ItemRef ItemOID="IT.AE.AETERM" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.BLANK" Name="" Repeating="Yes" Purpose="Tabulation">
        <ItemRef ItemOID="IT.AE.AETERM" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" Repeating="No" Purpose="Tabulation"
                    SASDatasetName="DM">
        <ItemRef ItemOID="IT.DM.USUBJID" OrderNumber="1" KeySequence="1" Mandatory="Yes"
                 Role="Identifier"/>
        <ItemRef ItemOID="IT.DM.BLANK" OrderNumber="2" KeySequence="2" Mandatory="No"
                 Role="Identifier"/>
        <ItemRef ItemOID="IT.DM.NONAME" OrderNumber="3" KeySequence="3" Mandatory="No"
                 Role="Identifier"/>
        <ItemRef ItemOID="IT.DM.SEX" OrderNumber="4" Mandatory="Yes" Role="Record Qualifier"/>
      </ItemGroupDef>

      <ItemDef OID="IT.AE.AETERM" Name="AETERM" DataType="text" Length="200">
        <Description><TranslatedText xml:lang="en">Reported Term for the Adverse Event</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.DM.USUBJID" Name="USUBJID" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.DM.BLANK" Name="" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">A blank-named variable</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.DM.NONAME" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">A nameless variable</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.DM.SEX" Name="SEX" DataType="text" Length="1">
        <Description><TranslatedText xml:lang="en">Sex</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.SEX"/>
      </ItemDef>

      <CodeList OID="CL.SEX" Name="Sex" DataType="text">
        <CodeListItem CodedValue="M">
          <Decode><TranslatedText xml:lang="en">Male</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem>
          <Decode><TranslatedText xml:lang="en">No coded value at all</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="" def:ExtendedValue="Yes">
          <Decode><TranslatedText xml:lang="en">A blank coded value</TranslatedText></Decode>
        </CodeListItem>
        <CodeListItem CodedValue="F" def:ExtendedValue="Yes">
          <Decode><TranslatedText xml:lang="en">Female</TranslatedText></Decode>
        </CodeListItem>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
