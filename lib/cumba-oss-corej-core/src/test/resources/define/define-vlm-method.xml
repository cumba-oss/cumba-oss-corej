<?xml version="1.0" encoding="UTF-8"?>
<!-- Runbook W1b DV (PLAN-engine-gap-define-vlm-method): LB.LBSTRESC documented per LBTESTCD —
     GLUC by a value-level method (ItemRef/@MethodOID) with a def:Origin element, HGB by a
     value-level comment (ItemDef/@def:CommentOID) with the v1.0 @Origin attribute, SODIUM by
     nothing; LBORRES carries a variable-level method; DTYPE binds a codelist whose AVERAGE term
     has a decode and whose LOCF term has none. -->
<ODM xmlns:def="http://www.cdisc.org/ns/def/v2.1" ODMVersion="1.3.2" FileType="Snapshot"
     FileOID="DEF.VLM.METHOD" CreationDateTime="2026-01-01T00:00:00">
  <Study OID="S1">
    <MetaDataVersion OID="MDV.1" Name="Define VLM method" DefineVersion="2.1.0"
                     StandardName="SDTM-IG" StandardVersion="3.4">

      <ItemGroupDef OID="IG.LB" Name="LB" Domain="LB" Repeating="Yes" Purpose="Tabulation"
                    SASDatasetName="LB">
        <ItemRef ItemOID="IT.LB.LBTESTCD" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
        <ItemRef ItemOID="IT.LB.LBORRES" OrderNumber="2" Mandatory="No" Role="Result Qualifier"
                 MethodOID="MT.LBORRES"/>
        <ItemRef ItemOID="IT.LB.LBSTRESC" OrderNumber="3" Mandatory="No" Role="Result Qualifier"/>
        <ItemRef ItemOID="IT.LB.DTYPE" OrderNumber="4" Mandatory="No" Role="Qualifier"/>
      </ItemGroupDef>

      <ItemDef OID="IT.LB.LBTESTCD" Name="LBTESTCD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Lab Test Code</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBORRES" Name="LBORRES" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Result in Original Units</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC" Name="LBSTRESC" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Character Result/Finding in Std Format</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.LB.LBSTRESC"/>
      </ItemDef>
      <ItemDef OID="IT.LB.DTYPE" Name="DTYPE" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Derivation Type</TranslatedText></Description>
        <CodeListRef CodeListOID="CL.DTYPE"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.GLUC" Name="LBSTRESC_GLUC" DataType="float" Length="5">
        <Description><TranslatedText xml:lang="en">Glucose result</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.HGB" Name="LBSTRESC_HGB" DataType="float" Length="5"
               def:CommentOID="COM.HGB" Origin="Collected">
        <Description><TranslatedText xml:lang="en">Haemoglobin result</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.SODIUM" Name="LBSTRESC_SODIUM" DataType="float" Length="5">
        <Description><TranslatedText xml:lang="en">Sodium result</TranslatedText></Description>
      </ItemDef>

      <def:ValueListDef OID="VL.LB.LBSTRESC">
        <ItemRef ItemOID="IT.LB.LBSTRESC.GLUC" OrderNumber="1" Mandatory="No"
                 MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBSTRESC.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBSTRESC.SODIUM" OrderNumber="3" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.SODIUM"/>
        </ItemRef>
      </def:ValueListDef>

      <def:WhereClauseDef OID="WC.GLUC">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD" Comparator="EQ">
          <CheckValue>GLUC</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.HGB">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD" Comparator="EQ">
          <CheckValue>HGB</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.SODIUM">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD" Comparator="EQ">
          <CheckValue>SODIUM</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>

      <CodeList OID="CL.DTYPE" Name="Derivation Type" DataType="text">
        <CodeListItem CodedValue="AVERAGE">
          <Decode><TranslatedText xml:lang="en">Average of values</TranslatedText></Decode>
        </CodeListItem>
        <EnumeratedItem CodedValue="LOCF"/>
      </CodeList>

      <MethodDef OID="MT.GLUC" Name="Glucose derivation" Type="Computation">
        <Description><TranslatedText xml:lang="en">Converted to mmol/L.</TranslatedText></Description>
      </MethodDef>
      <MethodDef OID="MT.LBORRES" Name="Original result" Type="Computation">
        <Description><TranslatedText xml:lang="en">As collected.</TranslatedText></Description>
      </MethodDef>
      <def:CommentDef OID="COM.HGB">
        <Description><TranslatedText xml:lang="en">Reported as collected.</TranslatedText></Description>
      </def:CommentDef>
    </MetaDataVersion>
  </Study>
</ODM>
