<?xml version="1.0" encoding="UTF-8"?>
<!-- PLAN-stopped-rule-engine-fixes SR1 / T1: the variable-level value-level coverage accessors
     var_vlm_has_method / var_vlm_has_comment / var_vlm_has_origin ("DEFINE"). One LB variable per
     shape:
       LBSTRESC  two entries, each with a method, a comment and an origin      -> true  true  true
       LBORRES   two entries, the second carries nothing                        -> false false false
       LBSTAT    two entries, each with a method only                           -> true  false false
       LBTESTCD  no value list                                                  -> false false false
       LBSPEC    def:ValueListRef to a ValueListOID the define does not declare -> false false false
       LBMETHOD  a value list without any ItemRef                               -> false false false
       LBNAM     one entry whose ItemOID resolves to no ItemDef (documented
                 on the ItemRef side by a MethodOID)                            -> false false false
     PLAN-vlm-origin-value-accessor VO1: var_vlm_origin_types ("DEFINE"), the distinct origin types
     of the entries in value-list order ("" for an entry without an origin or whose ItemDef does
     not resolve):
       LBSTRESC  [Derived, Collected]   LBORRES [Collected, ""]   LBSTAT [""]   LBNAM [""]
       LBTESTCD / LBSPEC / LBMETHOD  []
       LBSTNRC   two entries, both def:Origin Collected, no variable-level origin -> [Collected]
       LBORNRLO  def:Origin Collected + the v1.0 @Origin="CRF", no variable level -> [Collected, CRF]
       LBSTNRU   variable-level def:Origin Derived, VL.COLLECTED                  -> [Collected]
     PLAN-vlm-unmethoded-origin-accessor (VU1-VU3, T3/T4): var_vlm_origin_types_without_method
     ("DEFINE"), the same list restricted to the entries whose ItemRef carries NO MethodOID ("" for
     such an entry without an origin or whose ItemDef does not resolve; an entry WITH a MethodOID
     contributes nothing, resolvable ItemDef or not):
       LBSTRESC / LBSTAT [] (every entry methoded)   LBORRES [""]   LBNAM [] (dangling, MethodOID)
       LBSTNRC [Collected]   LBORNRLO [Collected, CRF]   LBSTNRU [Collected]
       LBTESTCD / LBSPEC / LBMETHOD  []
       LBORNRHI  Derived+M, Collected, Collected, no origin (M3/M7 shape) -> [Collected, ""]
       LBSTRESN  a dangling ItemOID without a MethodOID, then Collected+M -> [""]
       LBSTRESU  Derived+M, Derived (M1)                                  -> [Derived]
       LBORRESU  Collected, Derived (M4)                                  -> [Collected, Derived]
       LBSTREFN  Derived, Assigned, no method (M2)                        -> [Derived, Assigned]
       LBREFID   M2's value list + a variable-level MethodOID (M6, T2)    -> [Derived, Assigned]
       LBSTREFC  variable-level origin Collected + M1's value list (M8, T1) -> [Derived]
     These seven carry a variable-level def:CommentOID, so the SR1 comment tests do not see them.
     The three VO1 variables' entries carry a comment (and LBSTNRC/LBORNRLO/LBSTNRU are not in the
     SR1 tests' data), so the SR1 comment tests do not see them.
     The comment is written as def:CommentOID on one entry and as CommentOID on another, and the
     origin as the 2.1 def:Origin element on one and the v1.0 @Origin attribute on another, so
     both spellings the provider reads at variable level count at value level too. -->
<ODM xmlns:def="http://www.cdisc.org/ns/def/v2.1" ODMVersion="1.3.2" FileType="Snapshot"
     FileOID="DEF.VLM.COVERAGE" CreationDateTime="2026-01-01T00:00:00">
  <Study OID="S1">
    <MetaDataVersion OID="MDV.1" Name="Define VLM coverage" DefineVersion="2.1.0"
                     StandardName="SDTM-IG" StandardVersion="3.4">

      <ItemGroupDef OID="IG.LB" Name="LB" Domain="LB" Repeating="Yes" Purpose="Tabulation"
                    SASDatasetName="LB">
        <ItemRef ItemOID="IT.LB.LBTESTCD" OrderNumber="1" Mandatory="Yes" Role="Topic"/>
        <ItemRef ItemOID="IT.LB.LBSTRESC" OrderNumber="2" Mandatory="No" Role="Result Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBORRES" OrderNumber="3" Mandatory="No" Role="Result Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTAT" OrderNumber="4" Mandatory="No" Role="Record Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSPEC" OrderNumber="5" Mandatory="No" Role="Record Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBMETHOD" OrderNumber="6" Mandatory="No" Role="Record Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBNAM" OrderNumber="7" Mandatory="No" Role="Record Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTNRC" OrderNumber="8" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBORNRLO" OrderNumber="9" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTNRU" OrderNumber="10" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBORNRHI" OrderNumber="11" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTRESN" OrderNumber="12" Mandatory="No" Role="Result Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTRESU" OrderNumber="13" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBORRESU" OrderNumber="14" Mandatory="No" Role="Variable Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBSTREFN" OrderNumber="15" Mandatory="No" Role="Result Qualifier"/>
        <ItemRef ItemOID="IT.LB.LBREFID" OrderNumber="16" Mandatory="No" Role="Identifier"
