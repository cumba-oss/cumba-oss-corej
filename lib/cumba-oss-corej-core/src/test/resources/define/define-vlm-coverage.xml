        <ItemRef ItemOID="IT.LB.LBSTREFC" OrderNumber="17" Mandatory="No" Role="Result Qualifier"/>
      </ItemGroupDef>

      <ItemDef OID="IT.LB.LBTESTCD" Name="LBTESTCD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Lab Test Code</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC" Name="LBSTRESC" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Character Result/Finding in Std Format</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.FULL"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBORRES" Name="LBORRES" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Result in Original Units</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.PARTIAL"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTAT" Name="LBSTAT" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Completion Status</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.METHOD_ONLY"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSPEC" Name="LBSPEC" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Specimen Type</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.NOWHERE"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBMETHOD" Name="LBMETHOD" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Method of Test</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.EMPTY"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBNAM" Name="LBNAM" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Vendor Name</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.DANGLING_ITEM"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTNRC" Name="LBSTNRC" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Normal Range for Character Results</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.COLLECTED"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBORNRLO" Name="LBORNRLO" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Reference Range Lower Limit in Orig Unit</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.COLLECTED_CRF"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTNRU" Name="LBSTNRU" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Normal Range Unit</TranslatedText></Description>
        <def:Origin Type="Derived"/>
        <def:ValueListRef ValueListOID="VL.COLLECTED"/>
      </ItemDef>

      <!-- PLAN-vlm-unmethoded-origin-accessor: seven variables, each with a variable-level
           comment and (but LBSTREFC) no variable-level origin -->
      <ItemDef OID="IT.LB.LBORNRHI" Name="LBORNRHI" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Reference Range Upper Limit in Orig Unit</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.MIXED_METHOD"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESN" Name="LBSTRESN" DataType="float" Length="8"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Numeric Result/Finding in Standard Units</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.DANGLING_NO_METHOD"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESU" Name="LBSTRESU" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Standard Units</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.M1"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBORRESU" Name="LBORRESU" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Original Units</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.M4"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTREFN" Name="LBSTREFN" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Reference Result in Standard Units</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.M2"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBREFID" Name="LBREFID" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Specimen ID</TranslatedText></Description>
        <def:ValueListRef ValueListOID="VL.M2"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTREFC" Name="LBSTREFC" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Reference Result in Std Format</TranslatedText></Description>
        <def:Origin Type="Collected"/>
        <def:ValueListRef ValueListOID="VL.M1"/>
      </ItemDef>

      <!-- VL.FULL: every entry documented three ways -->
      <ItemDef OID="IT.LB.LBSTRESC.GLUC" Name="LBSTRESC_GLUC" DataType="float" Length="5"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Glucose result</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTRESC.HGB" Name="LBSTRESC_HGB" DataType="float" Length="5"
               CommentOID="COM.HGB" Origin="Collected">
        <Description><TranslatedText xml:lang="en">Haemoglobin result</TranslatedText></Description>
      </ItemDef>
      <!-- VL.PARTIAL: the first entry documented three ways, the second by nothing -->
      <ItemDef OID="IT.LB.LBORRES.GLUC" Name="LBORRES_GLUC" DataType="float" Length="5"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Glucose original</TranslatedText></Description>
        <def:Origin Type="Collected"/>
      </ItemDef>
      <ItemDef OID="IT.LB.LBORRES.HGB" Name="LBORRES_HGB" DataType="float" Length="5">
        <Description><TranslatedText xml:lang="en">Haemoglobin original</TranslatedText></Description>
      </ItemDef>
      <!-- VL.METHOD_ONLY: both entries carry a method and nothing else -->
      <ItemDef OID="IT.LB.LBSTAT.GLUC" Name="LBSTAT_GLUC" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Glucose status</TranslatedText></Description>
      </ItemDef>
      <ItemDef OID="IT.LB.LBSTAT.HGB" Name="LBSTAT_HGB" DataType="text" Length="8">
        <Description><TranslatedText xml:lang="en">Haemoglobin status</TranslatedText></Description>
      </ItemDef>
      <!-- VL.COLLECTED: both entries Collected (VO1) -->
      <ItemDef OID="IT.LB.COLL.GLUC" Name="COLL_GLUC" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Glucose collected</TranslatedText></Description>
        <def:Origin Type="Collected"/>
      </ItemDef>
      <ItemDef OID="IT.LB.COLL.HGB" Name="COLL_HGB" DataType="text" Length="20"
               def:CommentOID="COM.HGB">
        <Description><TranslatedText xml:lang="en">Haemoglobin collected</TranslatedText></Description>
        <def:Origin Type="Collected"/>
      </ItemDef>
      <!-- VL.COLLECTED_CRF: the 2.1 element Collected, then the v2.0 attribute CRF (VO1) -->
      <ItemDef OID="IT.LB.CRF.GLUC" Name="CRF_GLUC" DataType="text" Length="20"
               def:CommentOID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Glucose lower limit</TranslatedText></Description>
        <def:Origin Type="Collected"/>
      </ItemDef>
      <ItemDef OID="IT.LB.CRF.HGB" Name="CRF_HGB" DataType="text" Length="20"
               CommentOID="COM.HGB" Origin="CRF">
        <Description><TranslatedText xml:lang="en">Haemoglobin lower limit</TranslatedText></Description>
      </ItemDef>
      <!-- PLAN-vlm-unmethoded-origin-accessor: Derived / Assigned entries and one without an
           origin -->
      <ItemDef OID="IT.LB.DER.GLUC" Name="DER_GLUC" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Glucose derived</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.LB.DER.HGB" Name="DER_HGB" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Haemoglobin derived</TranslatedText></Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.LB.ASG.HGB" Name="ASG_HGB" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Haemoglobin assigned</TranslatedText></Description>
        <def:Origin Type="Assigned"/>
      </ItemDef>
      <ItemDef OID="IT.LB.NOORIG.SODIUM" Name="NOORIG_SODIUM" DataType="text" Length="20">
        <Description><TranslatedText xml:lang="en">Sodium, no origin</TranslatedText></Description>
      </ItemDef>

      <def:ValueListDef OID="VL.FULL">
        <ItemRef ItemOID="IT.LB.LBSTRESC.GLUC" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBSTRESC.HGB" OrderNumber="2" Mandatory="No" MethodOID="MT.HGB">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.PARTIAL">
        <ItemRef ItemOID="IT.LB.LBORRES.GLUC" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBORRES.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.METHOD_ONLY">
        <ItemRef ItemOID="IT.LB.LBSTAT.GLUC" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.LBSTAT.HGB" OrderNumber="2" Mandatory="No" MethodOID="MT.HGB">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.COLLECTED">
        <ItemRef ItemOID="IT.LB.COLL.GLUC" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.COLL.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.COLLECTED_CRF">
        <ItemRef ItemOID="IT.LB.CRF.GLUC" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.CRF.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.MIXED_METHOD">
        <ItemRef ItemOID="IT.LB.LBSTRESC.GLUC" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.COLL.GLUC" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.COLL.HGB" OrderNumber="3" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.NOORIG.SODIUM" OrderNumber="4" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.DANGLING_NO_METHOD">
        <ItemRef ItemOID="IT.LB.LBSTRESN.NOWHERE" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.COLL.HGB" OrderNumber="2" Mandatory="No" MethodOID="MT.HGB">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.M1">
        <ItemRef ItemOID="IT.LB.LBSTRESC.GLUC" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.DER.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.M4">
        <ItemRef ItemOID="IT.LB.COLL.GLUC" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.DER.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.M2">
        <ItemRef ItemOID="IT.LB.DER.GLUC" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
        <ItemRef ItemOID="IT.LB.ASG.HGB" OrderNumber="2" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.HGB"/>
        </ItemRef>
      </def:ValueListDef>
      <def:ValueListDef OID="VL.EMPTY"/>
      <def:ValueListDef OID="VL.DANGLING_ITEM">
        <ItemRef ItemOID="IT.LB.LBNAM.NOWHERE" OrderNumber="1" Mandatory="No" MethodOID="MT.GLUC">
          <def:WhereClauseRef WhereClauseOID="WC.GLUC"/>
        </ItemRef>
      </def:ValueListDef>

      <def:WhereClauseDef OID="WC.GLUC">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD" Comparator="EQ">
          <CheckValue>GLUC</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.HGB">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.LB.LBTESTCD" Comparator="EQ">
          <CheckValue>HGB</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>

      <MethodDef OID="MT.GLUC" Name="Glucose derivation" Type="Computation">
        <Description><TranslatedText xml:lang="en">Converted to mmol/L.</TranslatedText></Description>
      </MethodDef>
      <MethodDef OID="MT.HGB" Name="Haemoglobin derivation" Type="Computation">
        <Description><TranslatedText xml:lang="en">Converted to g/L.</TranslatedText></Description>
      </MethodDef>
      <def:CommentDef OID="COM.GLUC">
        <Description><TranslatedText xml:lang="en">Glucose as reported.</TranslatedText></Description>
      </def:CommentDef>
      <def:CommentDef OID="COM.HGB">
        <Description><TranslatedText xml:lang="en">Haemoglobin as reported.</TranslatedText></Description>
      </def:CommentDef>
    </MetaDataVersion>
  </Study>
</ODM>
