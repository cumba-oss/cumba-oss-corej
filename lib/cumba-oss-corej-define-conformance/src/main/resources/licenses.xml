<?xml version="1.0" encoding="UTF-8"?>
<!--
    Third-party attribution for the About dialog: the XML schemas under xsd/.

    net.cumba.dataviewer.licenses.LicenseReader aggregates EVERY licenses.xml on the
    classpath, so attribution is additive per module: this file contributes its rows to
    the dialog without any change to the application.

    One row per licensor family. The schemas are redistributed on the footing of CDISC's
    own MIT-licensed GitHub repositories (cdisc-org/define-xml-2.0-stylesheets,
    cdisc-org/define-xml-2.1-stylesheets, cdisc-org/DataExchange-ODM), where the same
    files are published byte-identical; xmldsig-core-schema.xsd is additionally governed
    by the W3C Software Notice and License it names. Full record: xsd/README.md; licence
    texts: META-INF/NOTICE-xsd.txt.

    Two rules this file must keep:

      * The coordinates are the UPSTREAM publisher's, never net.cumba. AboutPanel skips
        every entry whose groupId is exactly "net.cumba", so an attribution row filed
        under our own coordinates is invisible while looking correct.

      * LicenseInfo is a value object over groupId/artifactId/version/name/url held in a
        HashSet, and the dialog renders only groupId/artifactId/name. Keep each tuple
        BYTE-IDENTICAL wherever it is declared. LicenseReader reads only the FIRST
        <license> of a <dependency>, so each row carries exactly one.

    This module has no AttributionTest (it walks *.java only and cannot see .xsd); the
    (groupId, artifactId) pairs are pinned instead by REQUIRED in the meta repository's
    check_release_licenses.py. Change the two together.
-->
<licenseSummary>
  <dependencies>
    <dependency>
      <groupId>CDISC</groupId>
      <artifactId>Define-XML 2.0 schema</artifactId>
      <version>2.0.0</version>
      <licenses>
        <license>
          <name>MIT License</name>
          <url>https://github.com/cdisc-org/define-xml-2.0-stylesheets/blob/master/LICENSE.md</url>
        </license>
      </licenses>
    </dependency>
    <dependency>
      <groupId>CDISC</groupId>
      <artifactId>Define-XML 2.1 schema</artifactId>
      <version>2.1.0</version>
      <licenses>
        <license>
          <name>MIT License</name>
          <url>https://github.com/cdisc-org/define-xml-2.1-stylesheets/blob/master/LICENSE.md</url>
        </license>
      </licenses>
    </dependency>
    <dependency>
      <groupId>CDISC</groupId>
      <artifactId>ODM 1.3.2 schema</artifactId>
      <version>1.3.2</version>
      <licenses>
        <license>
          <name>MIT License</name>
          <url>https://github.com/cdisc-org/define-xml-2.1-stylesheets/blob/master/LICENSE.md</url>
        </license>
      </licenses>
    </dependency>
    <dependency>
      <groupId>CDISC</groupId>
      <artifactId>Analysis Results Metadata 1.0 schema</artifactId>
      <version>1.0.0</version>
      <licenses>
        <license>
          <name>MIT License</name>
          <url>https://github.com/cdisc-org/define-xml-2.1-stylesheets/blob/master/LICENSE.md</url>
        </license>
      </licenses>
    </dependency>
    <dependency>
      <groupId>CDISC</groupId>
      <artifactId>ODM 1.3.2 core schemas (xml.xsd, xlink.xsd)</artifactId>
      <version>1.3.2</version>
      <licenses>
        <license>
          <name>MIT License</name>
          <url>https://github.com/cdisc-org/DataExchange-ODM/blob/main/LICENSE</url>
        </license>
      </licenses>
    </dependency>
    <dependency>
      <groupId>W3C</groupId>
      <artifactId>XML Signature schema (xmldsig-core-schema.xsd)</artifactId>
      <version>1.2</version>
      <licenses>
        <license>
          <name>W3C Software Notice and License (1998-07-20)</name>
          <url>https://www.w3.org/Consortium/Legal/copyright-software-19980720</url>
        </license>
      </licenses>
    </dependency>
  </dependencies>
</licenseSummary>
