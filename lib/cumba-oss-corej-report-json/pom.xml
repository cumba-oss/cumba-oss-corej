<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-corej-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-corej-report-json</artifactId>

    <name>Cumba OSS coreJ :: JSON Report Writer</name>
    <url>https://github.com/cumba-oss/cumba-oss-corej</url>
    <packaging>jar</packaging>

    <inceptionYear>2026</inceptionYear>
    <description>
        Pluggable JSON report writers for the corej validation report.
        Registers TWO formats with the engine's ReportWriterSupplier SPI -
        "json" (the frozen v1 schema) and "json-2" (the combined-finding v2
        report) - because both serialise the same assembled sections through
        the same mapper; splitting them into two modules would be dishonest
        granularity.
    </description>

    <properties>
        <!-- Repo-root anchor, depth 2 (see the root pom). -->
        <repo.root.dir>${project.basedir}/../..</repo.root.dir>

        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>

        <!--
            === Quality floors ===

            ⚠ The module is a few small classes with only a handful of mutants, so treat a green
            here as weak evidence and read the tests, not the percentage. It is still worth
            arming: the inherited root defaults include a test-strength floor of 0, which cannot
            fail at any score.

            The floors are NOT 100: a ratchet set at the measurement reds on the next mutant the
            tooling learns to generate, which is a gate that fails for being improved. Measured
            minus about two points is the campaign's standing margin
            (plans/PLAN-clinical-path-test-strength.md section 5.2).

            ⛔ A floor is never lowered. If a change drops this module below one of them, the change
            is wrong or its tests are missing - do not re-base the number. Never pass
            -Dpitest.mutation.threshold or -Djacoco.line.coverage on the command line either; a CLI
            -D clobbers every module's value at once.
        -->
        <pitest.mutation.target>98</pitest.mutation.target>
        <pitest.coverage.target>98</pitest.coverage.target>
        <pitest.test.strength.target>98</pitest.test.strength.target>
        <jacoco.line.coverage>0.98</jacoco.line.coverage>
    </properties>

    <dependencies>

        <!-- The report SPI (ReportWriter / ReportWriterSupplier / ReportFormat) plus the neutral
             ReportSections model. This is the ONLY corej dependency a writer module may need; the
             import guard in WriterModuleImportGuardTest pins that. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-corej-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


</project>
